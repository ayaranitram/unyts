<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  PrivacyInfo.xcprivacy — App Privacy Manifest (required by Apple since Spring 2024)
  ─────────────────────────────────────────────────────────────────────────────────
  Unyts performs ALL computation on-device using the C++ engine (libunyts.a).
  It does NOT collect, transmit, or share any user data.
-->
<plist version="1.0">
<dict>
    <!-- No data is collected. -->
    <key>NSPrivacyCollectedDataTypes</key>
    <array/>

    <!-- No tracking. -->
    <key>NSPrivacyTracking</key>
    <false/>

    <!-- No tracking domains. -->
    <key>NSPrivacyTrackingDomains</key>
    <array/>

    <!--
      Required Reason APIs used by this app.
      UserDefaults (@AppStorage) is used to persist FVF and timeout settings.
    -->
    <key>NSPrivacyAccessedAPITypes</key>
    <array>
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryUserDefaults</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <!-- CA92.1: Read/write info tied to the app itself -->
                <string>CA92.1</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
